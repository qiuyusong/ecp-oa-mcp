# ECP (Enterprise Cloud Platform / AIPower) Configuration
# OA 接口默认共用此 ECP_BASE_URL 与登录会话
ECP_BASE_URL=https://econtact.gemfor.com.tw/ecp
ECP_USERNAME=your_username
ECP_PASSWORD=your_password
ECP_TENANT_ID=
ECP_AUTH_TOKEN=

# [可选] 仅当 OA 服务为独立外网独立域名时才需要配置，默认不需要配
# OA_BASE_URL=

# 用户身份与部门 (可选)
USER_ID=
USER_NAME=
USER_DEPARTMENT_ID=

# 本地 Git 仓库映射（用于从 Git Commit 自动汇总并填报工时）
# 格式: repo_name=本地路径;repo_name2=本地路径2
GIT_PROJECTS=springcloud-aile=E:\develop\project\springcloud-aile;aipower=E:\develop\project\aipower
DEFAULT_DAILY_HOURS=8.0
