# ECP (Enterprise Cloud Platform / AIPower) Configuration
# OA 接口默认共用此 ECP_BASE_URL 与登录会话
ECP_BASE_URL=https://econtact.gemfor.com.tw/ecp
ECP_USERNAME=your_username
ECP_PASSWORD=your_password
ECP_TENANT_ID=
ECP_AUTH_TOKEN=

# [可选] 仅当 OA 服务为独立外网独立域名时才需要配置，默认不需要配
# OA_BASE_URL=

# 用户身份与部门 (可选)
USER_ID=
USER_NAME=
USER_DEPARTMENT_ID=

# [可选] 本地 Git 仓库映射（用于从 Git Commit 自动汇总并填报工时，若不配置则默认取当前打开的项目目录）
# 格式: repo_name=本地绝对路径;repo_name2=本地绝对路径2
# Windows 示例: GIT_PROJECTS=backend=D:\project\backend;frontend=D:\project\frontend
# Linux/Mac 示例: GIT_PROJECTS=backend=/Users/name/dev/backend;frontend=/Users/name/dev/frontend
GIT_PROJECTS=
DEFAULT_DAILY_HOURS=8.0
